# URL pública do app (sem barra no final). Local: http://localhost:3000
APP_URL=http://localhost:3000

# App do Strava: https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Texto qualquer que você escolhe; o Strava devolve na verificação do webhook.
STRAVA_WEBHOOK_VERIFY_TOKEN=

# Só este atleta do Strava pode entrar (seu id: 39350591). Deixe vazio para liberar qualquer um.
ALLOWED_ATHLETE_ID=39350591

# Postgres (Supabase/Neon). Use a connection string "pooled"/transaction mode na Vercel.
DATABASE_URL=

# Segredo para assinar o cookie de sessão. Gere com: openssl rand -base64 32
SESSION_SECRET=

# Opcional. Sem a chave, o feedback é gerado por regras (grátis).
# Com a chave, o Claude escreve o feedback: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Opcional: notificação no Telegram após cada corrida
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
